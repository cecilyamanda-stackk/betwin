# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SEO — the real production domain, no trailing slash (e.g.
# https://www.bet606.co.ke). Used to build the sitemap, robots.txt,
# canonical URLs, and Open Graph tags. Required for those to be correct
# in production — see lib/seo.ts.
NEXT_PUBLIC_SITE_URL=

# SEO — paste the verification code Google Search Console gives you when
# you add this property via the "HTML tag" method (see the setup guide).
# Leave blank if you verify via DNS or the sitemap-submission method
# instead — none of those need this.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Server-only — NEVER prefix with NEXT_PUBLIC_, never import into a Client Component
SUPABASE_SERVICE_ROLE_KEY=

# Only needed when running `npm run seed:admin` — not read by the app itself
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=
